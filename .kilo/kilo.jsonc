{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "external_directory": {
      "D:\\DEV/**": "allow",
      "*": "deny"
    }
  },
  "instructions": [
    ".kilo/rules/*.md"
  ],
  "indexing": {
    "enabled": false
  }
}