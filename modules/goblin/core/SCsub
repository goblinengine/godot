#!/usr/bin/env python
from misc.utility.scons_hints import *

import os as _os

Import("env_goblin")

env_goblin.add_source_files(env_goblin.goblin_sources, "*.cpp")

# The upstream core/SCsub declares only upstream files as sources for the
# generated branding headers (AUTHORS/DONORS/COPYRIGHT/LICENSE/version).
# The goblin builders read modules/goblin/core/* instead, so those files must
# be explicit dependencies or the headers never regenerate when they change.
_goblin_core = Dir(".").abspath

env_goblin.Depends("#core/authors.gen.h", _goblin_core + "/AUTHORS.md")
env_goblin.Depends("#core/donors.gen.h", _goblin_core + "/DONORS.md")
env_goblin.Depends("#core/license.gen.h", [_goblin_core + "/COPYRIGHT.txt", _goblin_core + "/LICENSE.txt"])
env_goblin.Depends("#core/version_generated.gen.h", _goblin_core + "/version_override.py")

# Same for the main/ branding headers: upstream main/SCsub keys them to
# #main/splash.png etc., but the goblin builders read modules/goblin/main/*.
_goblin_main = Dir("..").abspath + "/main"
env_goblin.Depends("#main/splash.gen.h", _goblin_main + "/splash.png")
env_goblin.Depends("#main/splash_editor.gen.h", _goblin_main + "/splash_editor.png")
env_goblin.Depends("#main/app_icon.gen.h", _goblin_main + "/app_icon.png")
