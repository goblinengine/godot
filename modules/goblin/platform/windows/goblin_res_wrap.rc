// Windows resource file for Goblin Engine (console wrapper executable).
// Swapped in by the RES hook in modules/goblin/config.py.

#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

GODOT_ICON ICON modules/goblin/platform/windows/goblin.ico
1 RT_MANIFEST "platform/windows/godot.manifest"

1 VERSIONINFO
FILEVERSION     GODOT_VERSION_MAJOR,GODOT_VERSION_MINOR,GODOT_VERSION_PATCH,0
PRODUCTVERSION  GODOT_VERSION_MAJOR,GODOT_VERSION_MINOR,GODOT_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            "Goblin Engine"
            VALUE "FileDescription",        GODOT_VERSION_NAME " (Console)"
            VALUE "FileVersion",            GODOT_VERSION_NUMBER
            VALUE "ProductName",            GODOT_VERSION_NAME " (Console)"
            VALUE "Licence",                "MIT"
            VALUE "LegalCopyright",         "(c) 2026-present Goblin Engine contributors; (c) 2014-present Godot Engine contributors"
            VALUE "Info",                   "https://goblin-engine.org"
            VALUE "ProductVersion",         GODOT_VERSION_FULL_BUILD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
